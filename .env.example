# ─────────────────────────────────────────────────────────────────────────────
# 1. HẠ TẦNG & BÍ MẬT (Bắt buộc cấu hình ở .env - Cần restart server khi đổi)
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DB_NAME=lensvocab
REDIS_URL=redis://localhost:6379/0

# Chìa khóa ký JWT Token (Bảo mật tuyệt đối, cấm commit vào git)
SECRET_KEY=replace-with-a-strong-random-secret

# AWS IAM Credentials (Rekognition, Bedrock, Polly)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Cấu hình AI AWS
# Chú ý: BEDROCK_EMBEDDING_MODEL_ID gắn cứng với dimension 1024 của MongoDB Atlas Vector Index
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ─────────────────────────────────────────────────────────────────────────────
# 2. GIÁ TRỊ MẶC ĐỊNH CHO HỆ THỐNG & USER
# (Quản trị viên có thể đổi động qua API /admin/settings; User đổi qua /users/me/preferences)
# ─────────────────────────────────────────────────────────────────────────────
# Giọng đọc mặc định (User có thể tùy chỉnh trong UserPreferences nếu là Premium)
POLLY_VOICE_ID=Joanna

# Hạn mức & Ngưỡng mặc định (Fallback khi MongoDB chưa có SystemSetting)
FREE_DAILY_QUOTA=10
REVIEW_DAILY_CAP=15
VISION_CONFIDENCE_THRESHOLD=0.50
SEMANTIC_SIMILARITY_THRESHOLD=0.85
