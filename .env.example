# Database & Cache
MONGODB_URL=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DB_NAME=lensvocab
REDIS_URL=redis://localhost:6379/0

# Security (JWT Secret Key)
SECRET_KEY=replace-with-a-strong-random-secret

# AWS IAM Credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-southeast-1           # Rekognition, Nova Lite, Polly → Singapore (gần VN nhất)
AWS_EMBEDDING_REGION=ap-southeast-2 # Titan Embeddings v2 chưa hỗ trợ ap-southeast-1 → Sydney

# AWS Bedrock Models
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
