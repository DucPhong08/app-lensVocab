# Database & Cache
MONGODB_URL=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DB_NAME=lensvocab
REDIS_URL=redis://localhost:6379/0

# Security (JWT Secret Key)
SECRET_KEY=replace-with-a-strong-random-secret

# AWS IAM Credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-southeast-1            # Singapore - Rekognition, Polly
AWS_EMBEDDING_REGION=ap-southeast-2  # Sydney - Nova Lite + Titan Embed V2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Network / Reverse Proxy (Optional)
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Google OAuth: Web application client ID, also used by the mobile SDK. Empty disables Google login.
GOOGLE_WEB_CLIENT_ID=

S3_IMAGE_BUCKET=
S3_IMAGE_URL_TTL_SECONDS=3600
S3_IMAGE_ENDPOINT_URL=
S3_IMAGE_ACCESS_KEY_ID=
S3_IMAGE_SECRET_ACCESS_KEY=
# Example: https://s3.us-east-005.backblazeb2.com

# CPU model for transparent PNG stickers (download with scripts/download_sticker_model.py).
IMAGE_SEGMENTATION_MODEL_PATH=models/u2netp.onnx
